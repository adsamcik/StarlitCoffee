    <string name="label_bloom_sprite_fuchsia_ballerina">紫红色芭蕾舞女演员</string>
    <string name="desc_bloom_sprite_fuchsia_ballerina">樱桃色的萼片扫过紫罗兰色的垂裙。</string>
    <string name="label_bloom_sprite_magnolia_dawn">玉兰黎明</string>
    <string name="desc_bloom_sprite_magnolia_dawn">毛茸茸的花蕾开放成一个象牙色的杯子，边缘呈粉红色。</string>
    <string name="label_bloom_sprite_iris_origami">鸢尾花折纸</string>
    <string name="desc_bloom_sprite_iris_origami">折叠的靛蓝花瓣围绕着金色信号升起并层叠。</string>
    <string name="label_bloom_sprite_king_protea_sunrise">国王普罗蒂亚日出</string>
    <string name="desc_bloom_sprite_king_protea_sunrise">灰粉色的苞片在柔软的冠周围呈环状展开。</string>
    <string name="label_bloom_sprite_dahlia_kaleidoscope">大丽花万花筒</string>
    <string name="desc_bloom_sprite_dahlia_kaleidoscope">珊瑚和覆盆子花瓣在精确的分层玫瑰花结中展开。</string>
    <string name="label_bloom_sprite_pincushion_firework">枕形烟花</string>
    <string name="desc_bloom_sprite_pincushion_firework">金色弧形款式从温暖的橙色中心向外延伸。</string>
    <string name="label_bloom_sprite_morning_glory_spiral">牵牛花螺旋</string>
    <string name="desc_bloom_sprite_morning_glory_spiral">一根卷曲的藤蔓打开后变成一个发光的钴喇叭。</string>
    <string name="label_bloom_sprite_foxglove_chimes">毛地黄铃声</string>
    <string name="desc_bloom_sprite_foxglove_chimes">三个粉色斑点铃铛在绿色的茎上依次开放。</string>
    <string name="label_bloom_sprite_cherry_blossom_wish">樱花的愿望</string>
    <string name="desc_bloom_sprite_cherry_blossom_wish">三朵贝壳粉红色的花朵沿着精致的咖啡棕色树枝开放。</string>
    <string name="label_bloom_sprite_himalayan_lantern">喜马拉雅灯笼</string>
    <string name="desc_bloom_sprite_himalayan_lantern">纸质的朱红色灯笼分开，露出温暖的金色花朵。</string>
    <string name="label_bloom_sprite_black_bat_flower">黑蝙蝠花</string>
    <string name="desc_bloom_sprite_black_bat_flower">深色的酒红色苞片展开成引人注目的有翼花朵。</string>
    <string name="label_bloom_sprite_water_lily_twilight">黄昏时的睡莲</string>
    <string name="desc_bloom_sprite_water_lily_twilight">淡紫色的黄昏花瓣落在紧凑的琥珀色中心周围。</string>
    <string name="label_bloom_sprite_moonphase_magnolia">月相玉兰</string>
    <string name="desc_bloom_sprite_moonphase_magnolia">一朵象牙月形的玉兰花围绕着金色的小星星开放。</string>
    <string name="label_bloom_sprite_crema_chrysanthemum">菊花</string>
    <string name="desc_bloom_sprite_crema_chrysanthemum">奶油和焦糖泡沫丝带卷曲成咖啡花玫瑰花结。</string>
    <string name="label_bloom_sprite_stained_glass_iris">彩色玻璃虹膜</string>
    <string name="desc_bloom_sprite_stained_glass_iris">宝石色调的虹膜面板围绕琥珀心展开。</string>
    <string name="label_bloom_sprite_aurora_anemone">极光海葵</string>
    <string name="desc_bloom_sprite_aurora_anemone">蓝绿色到紫罗兰色的花瓣围绕着午夜的中心展开。</string>
    <string name="label_bloom_sprite_constellation_blossom">星座绽放</string>
    <string name="desc_bloom_sprite_constellation_blossom">一朵淡色的五瓣花展现出里面微小的金色星座。</string>
