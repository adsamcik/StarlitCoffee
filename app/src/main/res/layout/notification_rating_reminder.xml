<?xml version="1.0" encoding="utf-8"?>
<!--
  Custom RemoteViews content for the rating-reminder notification.

  RemoteViews supports a small subset of layouts and views; this layout sticks
  to that subset (LinearLayout + TextView + ImageView) so it renders consistently
  across Android 8 (minSdk) and up. The four rating targets use the same custom
  cup-mark artwork as the app without adding system button chrome.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:id="@+id/notif_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAppearance="@style/TextAppearance.Compat.Notification.Title"
        android:maxLines="2"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/notif_body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textAppearance="@style/TextAppearance.Compat.Notification"
        android:maxLines="2"
        android:ellipsize="end" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal"
        android:weightSum="4">

        <ImageView
            android:id="@+id/notif_rate_1"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/cd_notif_rating_1"
            android:padding="6dp"
            android:scaleType="fitCenter"
            android:src="@drawable/rating_starlit_cup_bad" />

        <ImageView
            android:id="@+id/notif_rate_2"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/cd_notif_rating_2"
            android:padding="6dp"
            android:scaleType="fitCenter"
            android:src="@drawable/rating_starlit_cup_meh" />

        <ImageView
            android:id="@+id/notif_rate_3"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/cd_notif_rating_3"
            android:padding="6dp"
            android:scaleType="fitCenter"
            android:src="@drawable/rating_starlit_cup_good" />

        <ImageView
            android:id="@+id/notif_rate_4"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/cd_notif_rating_4"
            android:padding="6dp"
            android:scaleType="fitCenter"
            android:src="@drawable/rating_starlit_cup_awesome" />

    </LinearLayout>

</LinearLayout>
